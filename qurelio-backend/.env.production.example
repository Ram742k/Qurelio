# Qurelio SaaS Production Environment Configuration

APP_NAME="Qurelio Health"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.qureliohealth.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Database Configuration (MySQL Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qurelio_prod
DB_USERNAME=qurelio_user
DB_PASSWORD=SecurePasswordHere123!

# Session & Cache (Redis Production)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
CACHE_PREFIX=qurelio_cache:

# Queue Configuration (Redis + Supervisor / Horizon)
QUEUE_CONNECTION=redis

# Redis Connection
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=YourRedisPasswordHere
REDIS_PORT=6379

# Mail Configuration (SMTP Production)
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=YourSendGridAPIKey
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@qureliohealth.com"
MAIL_FROM_NAME="Qurelio Health"

# Cloud Storage (Cloudflare R2 / AWS S3)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=YourAccessKeyId
AWS_SECRET_ACCESS_KEY=YourSecretAccessKey
AWS_DEFAULT_REGION=auto
AWS_BUCKET=qurelio-production-assets
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payment Gateways (Production Credentials)
RAZORPAY_KEY=rzp_live_your_key_id
RAZORPAY_SECRET=your_razorpay_secret
PHONEPE_MERCHANT_ID=PGM123456789
PHONEPE_SALT_KEY=your_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=PRODUCTION

# CORS & Sanctum Security
SANCTUM_STATEFUL_DOMAINS=app.qureliohealth.com
SESSION_DOMAIN=.qureliohealth.com
